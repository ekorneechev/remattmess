import os
import sys
import logging
import argparse
import tempfile

from email import message_from_binary_file
from subprocess import check_output
from shlex import quote

VERSION = "0.6"

def backup_attach(msg, msg_filename):
    dirname = "%s.backup" % msg_filename
    os.mkdir(dirname)
    for part in msg.walk():
        filename = part.get_filename()
        if filename:
            fp = open(os.path.join(dirname, filename),'wb')
            fp.write(part.get_payload(decode=True))
            fp.close()
    return

def is_attachment(part):
    """Return True for parts to zero, False for message body parts."""
    if part.get_content_maintype() == 'multipart':
        return False
    disposition = part.get('Content-Disposition')
    if disposition:
        disposition = disposition.split(';', 1)[0].strip().lower()
    else:
        disposition = ''
    if disposition == 'attachment':
        return True
    if part.get_filename():
        return True
    if part.get_content_maintype() == 'text':
        return False
    return disposition == 'inline' or bool(part.get('Content-ID'))

def zero_attachments(msg):
    """Zero attachment payloads in place, preserving their headers."""
    attach_list = []
    for part in msg.walk():
        if not is_attachment(part):
            continue
        attach_list.append(part.get_filename() or "(no name)")
        part.set_payload("")
    return attach_list

def write_msg(msg, msg_filename):
    """Write message to a temporary file and atomically replace the original."""
    directory = os.path.dirname(os.path.abspath(msg_filename))
    fd, tmp_filename = tempfile.mkstemp(prefix=".remattmess-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "wb") as fp:
            fp.write(msg.as_bytes())
        os.chmod(tmp_filename, os.stat(msg_filename).st_mode & 0o7777)
        os.replace(tmp_filename, msg_filename)
    except Exception:
        try:
            os.unlink(tmp_filename)
        except OSError:
            pass
        raise

def update():
    "Updating script"
    print( "Checking version...")
    currentVersion = check_output( "curl -f https://raw.githubusercontent.com/ekorneechev/remattmess/master/VERSION 2>/dev/null; exit 0",
                                   shell=True, universal_newlines=True ).strip()
    if not currentVersion:
        print( "Check your Internet connection!" )
        return 6
    if VERSION == currentVersion:
        print ( "Your version is actual: %s" %VERSION )
        return 0
    else:
        user_input = input( "Do you want to upgrade to the current version? ")
        if not user_input.lower() in [ "yes", "y" ]:
            return 130
        script_path = os.path.realpath(__file__)
        fd, tmp_filename = tempfile.mkstemp(prefix=".remattmess-", suffix=".tmp", dir=os.path.dirname(script_path))
        os.close(fd)
        try:
            if os.system( "curl -f -o %s https://raw.githubusercontent.com/ekorneechev/remattmess/master/remattmess" % quote(tmp_filename) ):
                print( "Unable to download the update." )
                return 6
            os.chmod(tmp_filename, os.stat(script_path).st_mode & 0o7777)
            os.replace(tmp_filename, script_path)
        finally:
            if os.path.exists(tmp_filename):
                os.unlink(tmp_filename)
        print( "Update completed." )
        return 0

def main(args):
    parser = argparse.ArgumentParser( description="REMove ATTachments from MESSage", formatter_class=argparse.RawDescriptionHelpFormatter )
    parser.add_argument( "-d", "--debug", action = "store_true", dest = "debug", default = False,  help = "debug output" )
    parser.add_argument( "-u", "--update", action = "store_true", dest = "update", default = False,  help = "update script" )
    parser.add_argument( "message", type = str,  nargs = "?", metavar = "FILE", help = "message (file .eml or .msg) for remove" )
    parser.add_argument( "-v", "--version", action = "version", help = "show version", version = VERSION )
    args = parser.parse_args()

    msg_filename = args.message
    log_level = logging.DEBUG if args.debug else logging.INFO
    logging.basicConfig( filename = "/tmp/remattmess.log", format = '%(asctime)s - %(levelname)s: %(message)s', level = log_level )

    if args.update:
        return update()

    if not msg_filename:
        print ( "No file specified" )
        return 2

    try:
        fp = open(msg_filename, "rb")
        msg = message_from_binary_file(fp)
        fp.close()
    except Exception as e:
        logging.error( "Unable to convert file to message." )
        logging.debug( e )
        return 1

    logging.info("Start 'remattmess'. File: %s" % msg_filename)
    logging.debug( "File size 'before': %i KB" % ( os.path.getsize( msg_filename ) / 1024 ) )
    attach_list = zero_attachments(msg)
    if attach_list == []:
        logging.info( "The message has no attachments." )
        return 0
    logging.debug( "Attachments to zeroing: %s" % ", ".join( attach_list ) )
    try:
        write_msg(msg, msg_filename)
        logging.debug( "File size 'after': %i KB" % ( os.path.getsize( msg_filename ) / 1024 ) )
        logging.info( "Attachments zeroing completed." )
        return 0
    except Exception as e:
        logging.error( "Unable to write message to file." )
        logging.debug( e )
        return 1

if __name__ == '__main__':
    sys.exit(main(sys.argv))
